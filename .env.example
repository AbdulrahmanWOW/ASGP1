ASGP_ENVIRONMENT=development
ASGP_LOG_LEVEL=INFO
ASGP_API_PREFIX=/api/v1
ASGP_DATABASE_URL=postgresql+psycopg://asgp:change-me@127.0.0.1:5432/asgp
ASGP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# role:name:key entries (admin | user | agent). Keys must be >= 16 characters.
ASGP_AUTH_MODE=required
ASGP_API_KEYS=admin:ops:replace-with-a-long-random-admin-key,user:reviewer:replace-with-a-long-random-user-key,agent:demo-agent:replace-with-a-long-random-agent-key
ASGP_MAX_BLOCKS_PER_SESSION=5
# Hybrid pipeline: lexical | hashing | sentence-transformers ; judge: none | ollama
ASGP_ALIGNMENT_PROVIDER=lexical
ASGP_JUDGE=none
ASGP_OLLAMA_URL=http://127.0.0.1:11434
ASGP_JUDGE_MODEL=qwen2.5:3b
ASGP_REQUIRE_INTENT_TOKEN=false
# base64 of a 32-byte Ed25519 seed; empty = ephemeral key generated at startup (dev only)
ASGP_INTENT_SIGNING_KEY=
